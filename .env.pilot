# Development Environment Configuration
REACT_APP_ENV=pilot

# =============================================================================
# DUMMY DATA FLAG: Controls dummy data vs real API
# true  = Use dummy/mock data (no API calls)
# false = Use real API endpoints (default)
# =============================================================================
VITE_USE_DUMMY_DATA=false
VITE_FEDERATION_BASE_URL=/news/

# =============================================================================
# FEATURE FLAGS: Show/Hide sidebar menu items
# true  = Show menu item (default)
# false = Hide menu item
# =============================================================================
VITE_SHOW_IMO_PROFILE=true
VITE_SHOW_PORT_PROFILE=true

# Assets
REACT_APP_ASSETS_URL=/Intara_Image_Asset_new

# News
REACT_APP_NEWS_HEADLINES_URL=/saaranshnews/api/news/headlines
REACT_APP_NEWS_DETAILS_URL=/saaranshnews/api/news/details

# Search API URLs
REACT_APP_AUTOCOMPLETE_URL=/saaranshsearch/api/search/autoComplete
REACT_APP_SEARCH_URL=/saaranshsearch/api/search/keywords

# Geoserver
REACT_APP_GEOSERVER=/saaranshgeoserver
REACT_APP_GEOSERVER_BASEMAP=/aimosm/styles/osm-bright/{z}/{x}/{y}.png
REACT_APP_GEOSERVER_BOUNDARY=/boundary/geoserver/cite/wms

# # Profiler
REACT_APP_PROFILER_SERVICE_URL=/saaranshprofiler/api/profiler
REACT_APP_GRAPH_DATA=/saaranshneo4j/api/neo4j/query

# Map Layers Url
REACT_APP_OSM_LAYER=/proxy/wms
REACT_APP_STRATEGIC_FACILITIES=/agni/rest/services/NGF/TARGET/MapServer/
REACT_APP_INSTALLATIONS=/saaranshgeoserver/JANES/ows

# Last Update 
REACT_APP_LASTUPDATE_SERVICE_URL=/saaranshnews/api/news/get_last_updated_date

#chatPanel
DEV_OSINT_SEARCH_API_TARGET=/osintsearch/query

#Fetch chat history
DEV_FILEUTILS_API_TARGET=/fileutils/chat/store
VITE_CHAT_HISTORY_URL=/fileutils/chat/history