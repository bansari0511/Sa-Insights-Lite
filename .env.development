# Development Environment Configuration
REACT_APP_ENV=development

# =============================================================================
# DUMMY DATA FLAG: Controls dummy data vs real API
# true  = Use dummy/mock data (no API calls)
# false = Use real API endpoints (default)
# =============================================================================
VITE_USE_DUMMY_DATA=false
VITE_FEDERATION_BASE_URL=/
# =============================================================================
# FEATURE FLAGS: Show/Hide sidebar menu items
# true  = Show menu item (default)
# false = Hide menu item
# =============================================================================
VITE_SHOW_IMO_PROFILE=true
VITE_SHOW_PORT_PROFILE=true

# Relative urls - empty, Vite proxy handles everything
VITE_API_BASE_URL=
VITE_API_USERS_BASE_URL=

# Server Configuration
VITE_DEV_SERVER_PORT=9398
VITE_DEV_SERVER_HOST=0.0.0.0

# Proxy Configuration (for development)
# DEV_PROXY_TARGET=http://1.1.1.105:30016
DEV_PROXY_TARGET=http://1.1.1.105:30016
DEV_PROXY_AUTH_PATH_REWRITE=/auth
DEV_PROXY_USERS_PATH_REWRITE=/users


# REACT_APP_ASSETS_URL=http://1.1.1.24/Intara_Image_Asset_new

REACT_APP_ASSETS_URL=http://1.1.1.29/Intara_Image_Asset_new/

# News
REACT_APP_NEWS_HEADLINES_URL=http://1.1.1.11:5002/api/news/headlines
REACT_APP_NEWS_DETAILS_URL=http://1.1.1.11:5002/api/news/details

# Search API URLs
# REACT_APP_AUTOCOMPLETE_URL=http://1.1.1.11:5004/api/search/autoComplete
# REACT_APP_SEARCH_URL=http://1.1.1.11:5004/api/search/keywords

REACT_APP_AUTOCOMPLETE_URL=http://1.1.1.15:5003/api/search/autoComplete
REACT_APP_SEARCH_URL=http://1.1.1.15:5003/api/search/keywords

# Geoserver
REACT_APP_GEOSERVER=http://1.1.1.104:30009/geoserver
REACT_APP_GEOSERVER_BASEMAP=https://n.abc.com/tileserviceurl/service/wmts/rest/tileservice3D:blue_marble_basemap_3D/EPSG:3857/EPSG:3857:{z}/{y}/{x}?format=image/png
REACT_APP_GEOSERVER_BOUNDARY=http://1.1.1.104:30009/geoserver/cite/wms

# Map Layers Url
REACT_APP_OSM_LAYER=https://n.abc.com/proxy/wms
REACT_APP_STRATEGIC_FACILITIES=https://n.abc.com/agni/rest/services/NGF/TARGET/MapServer/
REACT_APP_INSTALLATIONS=http://1.1.1.104:30009/geoserver/JANES/ows


# Profiler
REACT_APP_PROFILER_SERVICE_URL=http://1.1.1.11:5004/api/profiler
REACT_APP_GRAPH_DATA=http://1.1.1.11:5004/api/neo4j/query



#chatPanel
DEV_OSINT_SEARCH_API_TARGET=http://1.1.1.9:8000/query
DEV_FILEUTILS_API_TARGET=http://1.1.1.105:30029/chat/store
VITE_CHAT_HISTORY_URL=http://1.1.1.15:5003/chat/history


# Last Update
REACT_APP_LASTUPDATE_SERVICE_URL=http://1.1.1.11:5002/api/news/get_last_updated_date


# Activity events (user behaviour) to user-analytics-svc: one bucket, app "saaransh" (src/services/activity.js)
VITE_ENABLE_ACTIVITY_TRACKING=false
VITE_ACTIVITY_EVENTS_URL=/useranalytics/api/analytics/events
