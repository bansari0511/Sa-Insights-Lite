# =============================================================================
# Production Environment Configuration for SA Insights (NEWS app)
# Build: npm run build -- --mode production
# =============================================================================

REACT_APP_ENV=production

# Feature flags
VITE_SHOW_IMO_PROFILE=true
VITE_SHOW_PORT_PROFILE=true
VITE_SHOW_INSIGHTS_SIDEBAR=true

# Demo mode off in production (host provides auth via federation)
VITE_DEMO_MODE=false

# Auth endpoints (proxied via nginx in production)
VITE_API_BASE_URL=
VITE_API_LOGIN_ENDPOINT=/api/auth/login
VITE_API_LOGOUT_ENDPOINT=/api/auth/logout
VITE_API_REFRESH_ENDPOINT=/api/auth/refresh
VITE_API_AUTH_INFO_ENDPOINT=/api/secure/info
VITE_API_ENTITLEMENTS_ENDPOINT=/api/entitlements
VITE_CURRENT_APP_ID=news

# Server Configuration
VITE_DEV_SERVER_PORT=9398
VITE_DEV_SERVER_HOST=0.0.0.0

# Federation base URL — no longer used for vite base path.
# vite.config.js always uses './' (relative) to avoid federation plugin path issues.
# VITE_FEDERATION_BASE_URL=/news/
