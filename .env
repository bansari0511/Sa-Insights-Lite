# Default Environment Configuration
# This file will be used as fallback when no specific environment is set
REACT_APP_ENV=development

# =============================================================================
# DUMMY DATA FLAG: Controls dummy data vs real API
# true  = Use dummy/mock data (no API calls)
# false = Use real API endpoints (default)
# =============================================================================
VITE_USE_DUMMY_DATA=false
VITE_DEMO_MODE = false
# Base path for deployment (context path)
VITE_BASE_PATH=/
VITE_CURRENT_APP_NAME='news'
VITE_FEDERATION_BASE_URL=/

# Micro frontends (context path)
VITE_SEARCH_APP_CONTEXT=
VITE_MARKETPLACE_APP_CONTEXT=
VITE_STUDIO_APP_CONTEXT=

# Auth Service Endpoints (optional - defaults are provided)
VITE_API_LOGIN_ENDPOINT=/api/auth/login
VITE_API_LOGOUT_ENDPOINT=/api/auth/logout
VITE_API_REFRESH_ENDPOINT=/api/auth/refresh
VITE_API_AUTH_INFO_ENDPOINT=/api/secure/info

# User Management
VITE_API_USERS_ENDPOINT=/users/api/users




#chatPanel
DEV_OSINT_SEARCH_API_TARGET=http://1.1.1.9:8000/query
DEV_FILEUTILS_API_TARGET=http://1.1.1.105:30029/chat/store
VITE_CHAT_HISTORY_URL=http://1.1.1.15:5003/chat/history

# Sources and Entitlements API Endpoint (test-user-management via Tyk gateway)
VITE_API_SOURCES_ENDPOINT=/users/api/users/authorization/getSourcesByUserId
# VITE_API_ENTITLEMENTS_ENDPOINT=/users/api/users/authorization/getEntitlementsByUserId
# =============================================================================
# ASSETS SERVICE URL (for LAN deployment)
# Set this to the assets server URL on your LAN 
# When set, all media URLs (images, videos, audio, documents) resolve against it
# When empty, assets are served from the Vite public folder (local dev)
# =============================================================================
# REACT_APP_ASSETS_URL=http://1.1.1.11
